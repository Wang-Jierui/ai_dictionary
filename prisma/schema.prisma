generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Settings {
  id               String   @id @default("default")
  interests        String[] @default([])
  customPrompt     String   @default("")
  aiEndpoints      Json     @default("[]")
  sectionOrder     Json     @default("[]")
  batchMaxWords    Int      @default(50)
  batchConcurrency Int      @default(3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SearchHistory {
  id        String   @id @default(cuid())
  word      String
  createdAt DateTime @default(now())

  @@index([word])
  @@index([createdAt])
}

model Vocabulary {
  id                  String    @id @default(cuid())
  word                String    @unique
  phonetic            String?
  briefDefinition     String
  chineseDefinition   String?
  notes               String?
  dictData            Json?
  aiData              Json?
  imageData           String?
  imageMode           String?
  reviewEaseFactor    Float     @default(2.5)
  reviewIntervalDays  Int       @default(0)
  reviewRepetitionCount Int     @default(0)
  reviewLapses        Int       @default(0)
  reviewDueAt         DateTime?
  reviewLastReviewedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([createdAt])
}

model RoleplaySession {
  id         String   @id @default(cuid())
  targetWord String
  scenario   String
  messages   Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SceneHistory {
  id            String   @id @default(cuid())
  scene         String
  expressions   Json
  dialogue      String
  culturalNotes String   @default("")
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model WordChat {
  id           String   @id @default(cuid())
  word         String   @unique
  messages     Json     @default("[]")
  activeLeafId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([word])
}

model UserApiConfig {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  aiEndpoints  Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
